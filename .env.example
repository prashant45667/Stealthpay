# StealthPay Environment Configuration Template

# Midnight Network Configuration
NEXT_PUBLIC_MIDNIGHT_NETWORK="Midnight Preprod Testnet"
NEXT_PUBLIC_MIDNIGHT_INDEXER_URI="https://indexer.preprod.midnight.network/api/v1/graphql"
NEXT_PUBLIC_MIDNIGHT_NODE_RPC="https://rpc.preprod.midnight.network"
NEXT_PUBLIC_PROOF_SERVER_URI="http://127.0.0.1:6300"

# GitHub Author & CI Integration (Keep token private in .env.local)
GITHUB_USERNAME="your-github-username"
GITHUB_TOKEN="ghp_your_github_token_here"
GITHUB_REPO_URL="https://github.com/your-username/StealthPay"
